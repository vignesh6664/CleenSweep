model CloudAccount {
  id          String       @id @default(uuid())
  accountName String
  provider    Provider
  accessKey   String
  secretKey   String       // Encrypted
  region      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  scanResults ScanResult[]
  schedules   Schedule[]

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cloud_accounts")
}

enum Provider {
  AWS
  AZURE
  GCP
}
