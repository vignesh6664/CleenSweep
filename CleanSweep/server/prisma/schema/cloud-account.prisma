model CloudAccount {
  id          String       @id @default(uuid())
  accountName String
  provider    Provider
  accessKey   String
  secretKey   String       // Encrypted
  region      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  scanResults ScanResult[]
}

enum Provider {
  AWS
  AZURE
  GCP
}
